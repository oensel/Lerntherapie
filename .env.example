# FinTS (Kontoabruf). Produkt-ID kostenlos registrieren: https://www.fints.org/de/hersteller/produktregistrierung
# Bank-URL und BLZ: siehe https://www.hbci-zka.de/institute/institut_auswahl.htm oder Angaben der Bank
FINTS_PRODUKT_ID=
FINTS_URL=
FINTS_BLZ=
FINTS_BENUTZER=
FINTS_KUNDEN_ID=
FINTS_DEBUG=false

# Name des pushTAN-Geräts, falls die Bank ihn verlangt (sonst wird gefragt)
FINTS_TAN_MEDIUM=

# Automatischer Umsatzabruf (Server). Die PIN liegt nur in dieser Datei auf dem Home-Server (Rechte 600).
FINTS_PIN=
# Konto (IBAN), falls mehrere vorhanden; sonst das erste
FINTS_KONTO=
FINTS_ABRUFZEITEN=08:00,16:00
# "aus" schaltet den Zeitplan ab (z.B. in der Entwicklung)
FINTS_ZEITPLAN=an
TZ=Europe/Berlin
