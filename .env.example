PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=lerntherapie
DB_PASSWORD=bitte-aendern
DB_NAME=lerntherapie
JWT_SECRET=bitte-aendern

# FinTS (Kontoabruf). Produkt-ID kostenlos registrieren: https://www.fints.org/de/hersteller/produktregistrierung
# Bank-URL und BLZ: siehe https://www.hbci-zka.de/institute/institut_auswahl.htm oder Angaben der Bank
FINTS_PRODUKT_ID=
FINTS_URL=
FINTS_BLZ=
FINTS_BENUTZER=
FINTS_KUNDEN_ID=
FINTS_DEBUG=false

# Name des pushTAN-Geräts, falls die Bank ihn verlangt (sonst wird gefragt)
FINTS_TAN_MEDIUM=

# Automatischer Umsatzabruf (Server). Die PIN liegt nur in dieser Datei auf dem Home-Server (Rechte 600).
FINTS_PIN=
# Konto (IBAN), falls mehrere vorhanden; sonst das erste
FINTS_KONTO=
FINTS_ABRUFZEITEN=08:00,16:00
# "aus" schaltet den Zeitplan ab (z.B. in der Entwicklung)
FINTS_ZEITPLAN=an
TZ=Europe/Berlin

# Rechnungen: Praxisdaten für das PDF (Anschrift: Zeilen mit | trennen)
PRAXIS_NAME=Lernpraxis
PRAXIS_ANSCHRIFT=Musterstraße 1|12345 Musterstadt
PRAXIS_IBAN=
PRAXIS_BIC=
PRAXIS_BANK=
PRAXIS_STEUERNR=
PRAXIS_HINWEIS=Umsatzsteuerfrei gem. § 4 Nr. 21 UStG.
# Automatischer Lauf am 1. des Monats für den Vormonat ("aus" schaltet ihn ab)
RECHNUNG_LAUFZEIT=06:00
RECHNUNG_ZEITPLAN=an
# Mahnwesen: Tage nach Fälligkeit/Mahnfrist bis zur nächsten Stufe, neue Frist je Mahnung, Gebühren in Cent (Stufe 1 kostenfrei)
MAHN_KARENZ_TAGE=7
MAHN_FRIST_TAGE=10
MAHN_GEBUEHR_2_CENT=0
MAHN_GEBUEHR_3_CENT=0

# E-Mail-Versand von Rechnungen und Mahnungen (SMTP). Port 587 = STARTTLS, 465 = TLS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_ABSENDER=Lernpraxis <praxis@example.org>
# Kopie jeder versendeten Mail an die Praxis (optional)
MAIL_BCC=

# Schlüssel für verschlüsselt gespeicherte Passwörter/PIN (in der Anwendung eingetragen). Einmal erzeugen, z.B.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))" – danach nicht mehr ändern.
GEHEIM_SCHLUESSEL=
