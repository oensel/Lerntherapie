{
  "name": "lerntherapie-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch --env-file-if-exists=.env src/app.js",
    "migrate": "knex migrate:latest --knexfile knexfile.cjs",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.cjs",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "pg:start": "node scripts/lokale-pg.mjs start",
    "fints:test": "node scripts/fints-test.mjs",
    "demo:daten": "node scripts/demo-daten.mjs",
    "demo:finanzen": "node scripts/demo-finanzen.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "imapflow": "^2.12.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "lib-fints": "^1.5.3",
    "mailparser": "^3.15.0",
    "nodemailer": "^10.6.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "embedded-postgres": "^19.0.0-beta.20"
  }
}
